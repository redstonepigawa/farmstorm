# 构建产物与运行目录（不进版本库）
build/
run/
run-*/
logs/
.gradle/
src/generated/resources/.cache/
dist/

# 本地工具链（含 JDK / Gradle / NeoForge 镜像代理 / java.base 补丁，几百 MB，属于本机环境）
.tools/
.scratch/

# 外部素材包原件（作者提供的贴图包，归档备查；成品已进 src/main/resources）
# 含 crop_converter_a_32x32_pack / cultivator_a_animation_pack / outpost_core_all_textures
# 不出版本库的理由：这些是「源」，仓库里要的是「成品」；留档只为将来改尺寸/重导出时不至于丢失
.assets/

# 不属于项目的归档：会话转录、崩溃报告（体积大且含本机信息）
dsh-session-*.zip
错误报告-*.zip

# 机密：切勿提交
.token
*.token
.env

# IDE
.idea/
*.iml
.vscode/

# 截图采集件：只挑决定性的几张进 .work/，其余不入库（V-34 的采集产物）
.work/screenshots/
__pycache__/
*.pyc

# 本地从 jar 解包产生的残留（真正的资源在 src/main/resources 下，这里不该有东西）
/META-INF/
/assets/
/com/
/data/
/pack.mcmeta

# 本地跑服的其余产物（world / 崩溃报告 / 日志；run*/ 与 logs/ 已在上面）
world/
crash-reports/
*.log

# 操作系统与编辑器噪声
Thumbs.db
desktop.ini
.DS_Store

# 其它本地临时产物
node_modules/
*.tmp
